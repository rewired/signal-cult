{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BROKEN FM",
  "version": "0.1.0",
  "identifier": "com.rewired-vfx.broken-fm",
  "build": {
    "beforeDevCommand": "npm run stage",
    "beforeBuildCommand": "npm run stage",
    "frontendDist": "../../dist/build/windows-x64/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "BROKEN FM",
      "width": 1920,
      "height": 1080,
      "minWidth": 1280,
      "minHeight": 720,
      "resizable": true,
      "maximized": true
    }],
    "security": {
      "capabilities": ["main-capability"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' blob:"
      }
    }
  },
  "bundle": { "active": false }
}
